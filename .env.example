# MySQL 认证存储。复制为根目录 .env 后，在本地填写密码。
# MYSQL_AUTH_HOST=127.0.0.1
# MYSQL_AUTH_PORT=3306
# MYSQL_AUTH_DATABASE=myagent_auth
# MYSQL_AUTH_USER=root
# MYSQL_AUTH_PASSWORD=


# DeepSeek 模型服务
DEEPSEEK_API_KEY= 
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# DeepSeek 网络搜索 / 网页抓取（search_web / fetch_web）
DEEPSEEK_WEB_SEARCH_API_KEY= 
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_TIMEOUT=15

# ModelScope MCP 服务标识
MODELSCOPE_BING_SEARCH_MCP_TOKEN=
MODELSCOPE_CHARTS_MCP_TOKEN=

# OpenSandbox 服务
OPEN_SANDBOX_API_KEY=sk-harness-local-7c1a9e4b2d8f6a35
OPEN_SANDBOX_HOST=192.168.177.100
OPEN_SANDBOX_PORT=18083
OPEN_SANDBOX_IMAGE=myagent-sandbox:1
# 沙箱默认命令超时时间120s
OPEN_SANDBOX_DEFAULT_TIMEOUT_SECONDS=300
# 沙箱的生命周期24h，沙箱实例本身的生命周期上限，到期回收，防止长期占用资源。
OPEN_SANDBOX_SANDBOX_TIMEOUT_SECONDS=86400
# 沙箱预热机制
OPEN_SANDBOX_PREWARM_ENABLED=true
# Windows / Docker Desktop / 远程服务端场景必须走服务端代理
OPEN_SANDBOX_USE_SERVER_PROXY=true

# 异步子 Agent（Agent Protocol）服务地址
HARNESS_ASYNC_AGENT_PROTOCOL_URL=http://127.0.0.1:18082

# FastAPI 服务
HARNESS_API_HOST=127.0.0.1
HARNESS_API_PORT=8000

# 插件系统（v1.1）
HARNESS_PLUGINS_ENABLED=true
HARNESS_PLUGIN_MARKET_ENABLED=true
# HARNESS_PLUGIN_ROOT=  # 留空跟随 HARNESS_HOME/plugins
# 公共市场目录（可选）；为空时读取本地 plugins/catalog/catalog.json
# HARNESS_PLUGIN_CATALOG_URL=https://example.com/plugin-catalog.json
# 私有市场目录 URL；设置后与公共目录并存，私有源优先
# HARNESS_PLUGIN_REGISTRY_URL=  # 私有市场目录 URL
# 白名单（逗号分隔）；非空时只展示与安装列表内的 plugin_id
# HARNESS_PLUGIN_REGISTRY_WHITELIST=plugin-a,plugin-b
HARNESS_PLUGIN_HTTP_TIMEOUT_SECONDS=10
# DSH 社区目录接入；默认开启，按 QUERY 走 npm 镜像搜索，失败回退官方源
HARNESS_PLUGIN_DSH_ENABLED=true
HARNESS_PLUGIN_DSH_QUERY=awesome-dsh-plugin
HARNESS_PLUGIN_DSH_MIRROR_URL=https://registry.npmmirror.com
HARNESS_PLUGIN_DSH_FALLBACK_URL=https://registry.npmjs.org
# 每次目录刷新最多补多少个 npm 包详情（拿 tarball 与完整性字段）
HARNESS_PLUGIN_DSH_ENRICH_LIMIT=20
# 显式搜索地址；设置后不再按 QUERY 拼地址
# HARNESS_PLUGIN_DSH_CATALOG_URL=https://registry.npmmirror.com/-/v1/search?text=awesome-dsh-plugin&size=50
HARNESS_PLUGIN_VERSION_KEEP=2
HARNESS_PLUGIN_CATALOG_CACHE_SECONDS=600
HARNESS_PLUGIN_MAX_PROCESSES=8
HARNESS_PLUGIN_IDLE_TTL_SECONDS=300
HARNESS_PLUGIN_START_TIMEOUT_SECONDS=15
HARNESS_PLUGIN_CALL_TIMEOUT_SECONDS=60
# 安装前沙箱试运行；本地没有 OpenSandbox 时设为 false 仅做静态扫描
HARNESS_PLUGIN_SANDBOX_VERIFY=true
HARNESS_PLUGIN_MAX_PACKAGE_MB=32
HARNESS_PLUGIN_USER_QUOTA_MB=1024
HARNESS_PLUGIN_USER_MAX_PLUGINS=50
HARNESS_PLUGIN_AUTO_DISABLE_AFTER_FAILURES=5
HARNESS_VERSION=1.1.0
# 浏览器前端与 API 不同源时填写，逗号分隔；留空则回退到本地 Vite 开发来源
HARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MCP（可选）
# HARNESS_MCP_CONFIG_PATH=mcp_servers.yaml
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=18081
# MCP_PATH=/mcp

# LangGraph PostgreSQL 持久化
DB_HOST=192.168.177.100  # linux 虚拟机IP
DB_PORT=5432
DB_NAME=fluctuate_db
DB_USER=fluctuate_user
DB_PASSWORD=123456
DB_SSLMODE=disable

# 模型思考/推理模式开关（true/1/yes/on 视为开启，默认关闭）
HARNESS_MODEL_THINKING=true

# 上下文附件上传限制；支持格式见 src/api/context.py 的 SUPPORTED_FORMATS
HARNESS_CONTEXT_MAX_MB=20
HARNESS_CONTEXT_MAX_FILES=6
HARNESS_CONTEXT_MAX_CHARS=30000
# HARNESS_CONTEXT_DIR=  # 留空默认 <项目>/.harness/context
HARNESS_WEB_SEARCH=true
HARNESS_CONTEXT_COMPACT_ENABLED=true
HARNESS_CONTEXT_COMPACT_TRIGGER=0.7
HARNESS_CONTEXT_COMPACT_HARD=0.88
HARNESS_CONTEXT_COMPACT_KEEP=0.3
HARNESS_CONTEXT_COMPACT_MIN_ROUNDS=6
HARNESS_CONTEXT_COMPACT_COOLDOWN=3
HARNESS_CONTEXT_COMPACT_MAX_DEFER=3
HARNESS_CONTEXT_COMPACT_TIMEOUT=60
HARNESS_CONTEXT_COMPACT_EVAL_ENABLED=true
HARNESS_CONTEXT_EVAL_JUDGE=false
HARNESS_CONTEXT_COMPACT_HEARTBEAT=5
HARNESS_MODEL_CONTEXT_LIMIT=256000
HARNESS_SESSION_ARCHIVE_DAYS=7
# Msg Feedback 开关
HARNESS_FEEDBACK_ENABLED=true
HARNESS_PDCA_ENABLED=0

HARNESS_SCHEDULER_EXEC=true
HARNESS_SCHEDULER_ENABLED=true