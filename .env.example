# MySQL 认证存储。复制为根目录 .env 后，在本地填写密码。
# MYSQL_AUTH_HOST=127.0.0.1
# MYSQL_AUTH_PORT=3306
# MYSQL_AUTH_DATABASE=myagent_auth
# MYSQL_AUTH_USER=root
# MYSQL_AUTH_PASSWORD=


# DeepSeek 模型服务，（不局限于Deepseek，任何模型都可以）
DEEPSEEK_API_KEY= 
DEEPSEEK_BASE_URL= 
DEEPSEEK_MODEL_NAME=

# DeepSeek 网络搜索 / 网页抓取（search_web / fetch_web）
DEEPSEEK_WEB_SEARCH_API_KEY=
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SEARCH_TIMEOUT=15
# 联网搜索总开关：false 时不再向 Agent 绑定 search_web / fetch_web（前端开关会写这里）
# HARNESS_WEB_SEARCH=true

# ModelScope MCP 服务标识
MODELSCOPE_BING_SEARCH_MCP_TOKEN=
MODELSCOPE_CHARTS_MCP_TOKEN=

# OpenSandbox 服务
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_HOST=127.0.0.1
OPEN_SANDBOX_PORT=18083
OPEN_SANDBOX_IMAGE=myagent-sandbox:1
# 沙箱默认命令超时时间120s
OPEN_SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
# 沙箱的生命周期24h，沙箱实例本身的生命周期上限，到期回收，防止长期占用资源。
OPEN_SANDBOX_SANDBOX_TIMEOUT_SECONDS=86400
# 沙箱预热机制
OPEN_SANDBOX_PREWARM_ENABLED=true
# Windows / Docker Desktop / 远程服务端场景必须走服务端代理
OPEN_SANDBOX_USE_SERVER_PROXY=true

# 异步子 Agent（Agent Protocol）服务地址
HARNESS_ASYNC_AGENT_PROTOCOL_URL=http://127.0.0.1:18082

# FastAPI 服务
HARNESS_API_HOST=127.0.0.1
HARNESS_API_PORT=8000
# 浏览器前端与 API 不同源时填写，逗号分隔；留空则回退到本地 Vite 开发来源
HARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP（可选）
# 所有 MCP 服务的 JSON 配置统一写入一个文件；默认 mcp/servers.json
# HARNESS_MCP_ROOT=mcp
# HARNESS_MCP_CONFIG_PATH=mcp/servers.json
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=18081
# MCP_PATH=/mcp

# LangGraph PostgreSQL 持久化
DB_HOST=  # linux 虚拟机IP
DB_PORT=5432
DB_NAME= 
DB_USER= 
DB_PASSWORD=123456
DB_SSLMODE=disable

# 模型思考/推理模式开关（true/1/yes/on 视为开启，默认关闭）
HARNESS_MODEL_THINKING=false

# 上下文监控与轨迹
# 模型上下文窗口上限（tokens），仅用于占用率计算
HARNESS_MODEL_CONTEXT_LIMIT=128000
# 上下文占用告警阈值（0~1），只写日志
HARNESS_CONTEXT_ALERT_THRESHOLD=0.85
# 轨迹事件单个字段最大保留字符数
HARNESS_TRAJECTORY_MAX_TEXT=4000

# 技能库目录：留空时源码运行使用 src/agent/skills，打包运行使用用户数据目录
# HARNESS_SKILLS_ROOT=
# 用户数据目录（默认 Windows: %LOCALAPPDATA%/CommonHarness，其他: ~/.harness）
# 若该目录不可写（如 WinError 5），会自动降级到项目 .harness/user-data 或系统临时目录
# HARNESS_USER_DATA_DIR=
# 会话产物目录：留空时使用用户数据目录；每个 thread_id 一个子目录
# HARNESS_WORKSPACE_DIR=

# 宿主能力（本机执行 / 项目外读写）；默认关闭，关闭时模型看不到这些工具
# 总开关；开启后每次调用都会暂停等待人工审批，可选择“仅本会话允许”
HARNESS_HOST_ACCESS_ENABLED=false
# 分项开关（仅在总开关打开后生效）
HARNESS_HOST_EXEC_ENABLED=true
HARNESS_HOST_READ_ENABLED=true
HARNESS_HOST_WRITE_ENABLED=false
# 本机命令超时秒数（最大 600）与输出截断字符数
HARNESS_HOST_EXEC_TIMEOUT=120
HARNESS_HOST_EXEC_MAX_OUTPUT=30000
# 额外禁用的命令片段，逗号或分号分隔（默认已拦截 format/diskpart/shutdown/rm -rf 等）
# HARNESS_HOST_EXEC_DENY_COMMANDS=
# 单文件读写上限（MB）
HARNESS_HOST_READ_MAX_MB=10
HARNESS_HOST_WRITE_MAX_MB=10
# 允许写入项目外的根目录，分号分隔；为空表示项目外一律禁止写入
# HARNESS_HOST_WRITE_ROOTS=D:\输出;E:\交付
# 额外拒绝读写路径，分号分隔（系统目录、.ssh/.aws 等默认已拒绝）
# HARNESS_HOST_DENY_PATHS=
