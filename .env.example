# MySQL 认证存储。复制为根目录 .env 后，在本地填写密码。
# MYSQL_AUTH_HOST=127.0.0.1
# MYSQL_AUTH_PORT=3306
# MYSQL_AUTH_DATABASE=myagent_auth
# MYSQL_AUTH_USER=root
# MYSQL_AUTH_PASSWORD=


# DeepSeek 模型服务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# DeepSeek 网络搜索 / 网页抓取（search_web / fetch_web）
DEEPSEEK_WEB_SEARCH_API_KEY=
# 如果DEEPSEEK_BASE_URL要用非Deepseek的BaseURL，那可以将下面两个配置项取消注释，config会优先使用下面的环境变量
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SEARCH_TIMEOUT=15

# ModelScope MCP 服务标识
MODELSCOPE_BING_SEARCH_MCP_TOKEN=
MODELSCOPE_CHARTS_MCP_TOKEN=

# OpenSandbox 服务
OPEN_SANDBOX_API_KEY=sk-harness-local-7c1a9e4b2d8f6a35   # 本地沙箱的API_KEY,自己随便编写
OPEN_SANDBOX_HOST=192.168.177.100   # 本地沙箱服务部署的IP, 填写为自己所持有的IP
OPEN_SANDBOX_PORT=18083  # 沙箱服务端口
OPEN_SANDBOX_IMAGE=myagent-sandbox:1  # 默认沙箱镜像名
# 沙箱默认命令超时时间120s
OPEN_SANDBOX_DEFAULT_TIMEOUT_SECONDS=300
# 沙箱的生命周期24h，沙箱实例本身的生命周期上限，到期回收，防止长期占用资源。
OPEN_SANDBOX_SANDBOX_TIMEOUT_SECONDS=86400
# 沙箱预热机制
OPEN_SANDBOX_PREWARM_ENABLED=true
# Windows / Docker Desktop / 远程服务端场景必须走服务端代理
OPEN_SANDBOX_USE_SERVER_PROXY=true

# 异步子 Agent（Agent Protocol）服务地址
HARNESS_ASYNC_AGENT_PROTOCOL_URL=http://127.0.0.1:18082

# 上下文窗口与压缩
# 窗口既是展示口径，也是压缩判定分母；必须与实际模型窗口一致
HARNESS_MODEL_CONTEXT_LIMIT=128000
# 告警阈值与软水位对齐
HARNESS_CONTEXT_ALERT_THRESHOLD=0.70
HARNESS_CONTEXT_COMPACT_ENABLED=true
# 软水位 / 硬水位 / 保留预算，均相对可用预算 B = window - max(8000, 0.12*window)
HARNESS_CONTEXT_COMPACT_TRIGGER=0.70
HARNESS_CONTEXT_COMPACT_HARD=0.88
HARNESS_CONTEXT_COMPACT_KEEP=0.25
# 首次压缩前最少轮次、冷却模型调用次数、最大延迟次数、摘要超时
HARNESS_CONTEXT_COMPACT_MIN_ROUNDS=6
HARNESS_CONTEXT_COMPACT_COOLDOWN=3
HARNESS_CONTEXT_COMPACT_MAX_DEFER=3
HARNESS_CONTEXT_COMPACT_TIMEOUT=60
HARNESS_CONTEXT_COMPACT_EVAL_ENABLED=true
# LLM 时机裁判（额外一次摘要模型调用，默认关闭）与进度心跳间隔
HARNESS_CONTEXT_EVAL_JUDGE=false
HARNESS_CONTEXT_COMPACT_HEARTBEAT=5
# v2 评估驱动自动调参（每 N 次压缩评估小步调整阈值）与可选回执签名密钥
HARNESS_CONTEXT_AUTOTUNE_ENABLED=true
HARNESS_CONTEXT_AUTOTUNE_INTERVAL=20
HARNESS_COMPACTION_SIGNING_KEY=

# 会话自动归档：超过 N 天没有新记录时在进入对话页自动归档；0 表示关闭
HARNESS_SESSION_ARCHIVE_DAYS=30

# FastAPI 服务
HARNESS_API_HOST=127.0.0.1
HARNESS_API_PORT=8000
# 浏览器前端与 API 不同源时填写，逗号分隔；留空则回退到本地 Vite 开发来源
HARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP（可选）
# HARNESS_MCP_CONFIG_PATH=mcp_servers.yaml
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=18081
# MCP_PATH=/mcp

# LangGraph PostgreSQL 持久化
DB_HOST=192.168.177.100  # linux 虚拟机IP
DB_PORT=5432
DB_NAME=fluctuate_db
DB_USER=fluctuate_user
DB_PASSWORD=123456
DB_SSLMODE=disable

# 模型思考/推理模式开关（true/1/yes/on 视为开启，默认关闭）
HARNESS_MODEL_THINKING=false

# 上下文附件上传限制；支持格式见 src/api/context.py 的 SUPPORTED_FORMATS
HARNESS_CONTEXT_MAX_MB=20
HARNESS_CONTEXT_MAX_FILES=6
HARNESS_CONTEXT_MAX_CHARS=30000
# HARNESS_CONTEXT_DIR=  # 留空默认 <项目>/.harness/context
HARNESS_WEB_SEARCH=true
