# 本地密钥和环境配置
.env
.env.*
!.env.example

# Python 环境、缓存和测试产物
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
env/
myagent/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# JavaScript 依赖和构建产物（任意层级的 node_modules / dist）
node_modules/
dist/
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven 构建产物
**/target/
*.class
*.jar
*.war

# 应用运行状态、临时文件和日志
runtime/
.harness/
.langgraph_api/
*.log
*.sqlite
*.sqlite3
*.db
# 技能管理：被停用的技能目录是运行态数据
**/skills-disabled/

# MCP 运行态缓存与配置备份（servers.json 含访问令牌，不提交；格式见设计文档）
mcp/cache/
mcp/*.json.bak
mcp/servers.json
# MCP 服务工作目录：每个服务下载的包、npm 缓存与产物
.mcp/

# 本机调试/临时产物
.screenshots/
pip-*
harness-writable-test-*.tmp
*.tmp

# 编辑器和操作系统文件
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db

# 仅供本地保留的旧报告备份
readme.backup.md

useless/*

.trae/
